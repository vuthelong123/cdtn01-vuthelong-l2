# ============================================================================
# BIEN MOI TRUONG MAU CHO MEKONG MOBILE WARRANTY MANAGEMENT (BT3)
# Sao chep file nay thanh .env truoc khi chay Docker Compose:
#   cp .env.example .env
# ============================================================================

# --- MySQL 8.0 Container ---
MYSQL_ROOT_PASSWORD=root_sample_password_change_me
MYSQL_DATABASE=warranty_db
MYSQL_USER=warranty_user
MYSQL_PASSWORD=warranty_sample_password_change_me

# --- Web Flask App Connection ---
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=warranty_db
DB_USER=warranty_user
DB_PASSWORD=warranty_sample_password_change_me

# --- Flask Runtime ---
FLASK_SECRET=sample-dev-secret-change-in-production
FLASK_DEBUG=false
PORT=8000

